VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legacy (si usas la anon key clásica):
# VITE_SUPABASE_ANON_KEY=

# Tarjeta del pago por adelantado. El valor vive aquí o en el panel del sitio, no en el código.
VITE_PAYMENT_CARD_NUMBER=

# Setup
# 1. Abre SQL Editor en Supabase y ejecuta supabase/APPLY_ALL.sql (o las migraciones en orden)
# 2. Auth > Providers > Google
#    Callback: https://<ref>.supabase.co/auth/v1/callback
# 3. Redirect URLs: http://localhost:5173/** y tu dominio Netlify
# 4. Primer admin (después del primer login con Google):
#    insert into public.profiles (user_id, role, email)
#    values ('<uuid>', 'admin', 'tu@gmail.com')
#    on conflict (user_id) do update set role = 'admin';
