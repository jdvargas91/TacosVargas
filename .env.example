# Dominio canónico del sitio en producción (sin barra final).
# Se usa para canonical, Open Graph, sitemap y datos estructurados (SEO).
VITE_SITE_URL=https://vargastacos.com

# Prerender (scripts/prerender.ts): requiere Chromium de Playwright.
# Primera vez: pnpm exec playwright install chromium
# En CI sin navegador: SKIP_PRERENDER=1 pnpm build  (o pnpm build:no-prerender)

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legacy (si usas la anon key clásica):
# VITE_SUPABASE_ANON_KEY=

# Tarjeta del pago por adelantado. El valor vive aquí o en el panel del sitio, no en el código.
VITE_PAYMENT_CARD_NUMBER=

# Setup
# 1. Abre SQL Editor en Supabase y ejecuta supabase/APPLY_ALL.sql (o las migraciones en orden)
# 2. Auth > Providers > Google
#    Callback (en Google Cloud, no en localhost):
#    https://<ref>.supabase.co/auth/v1/callback
# 3. Auth > URL Configuration
#    Site URL = https://vargastacos.com  (UNA URL, sin /**)
#    Redirect URLs (lista, aquí sí wildcards):
#      http://localhost:5173/**
#      https://vargastacos.com/**
#      https://tacosvargas.<subdominio>.workers.dev/**
#    Si falta localhost en Redirect URLs, Google vuelve a / y no a /cuenta → /sistema.
# 4. Primer admin (después del primer login con Google):
#    insert into public.profiles (user_id, role, email)
#    values ('<uuid>', 'admin', 'tu@gmail.com')
#    on conflict (user_id) do update set role = 'admin';
#
# Cloudflare Workers
# Variables VITE_* (se hornean en el build, no son secretos de runtime):
#   Settings → Builds → Variables del build
# Secretos del cron (nunca en el cliente ni en git):
#   Settings → Variables and Secrets → Secret
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
# Copia local del cron: .dev.vars (ver .dev.vars.example)
